{
  "$defs": {
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "project",
            "context",
            "dataset",
            "dictionary",
            "intent",
            "profile",
            "diagnostic",
            "document",
            "instrument",
            "mapping",
            "recoding",
            "score",
            "plan",
            "result",
            "source_file",
            "source_sheet",
            "table",
            "table_context",
            "preparation",
            "snapshot"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Hash",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "revision",
        "hash"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0.0",
      "default": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "result_ref": {
      "$ref": "#/$defs/SourceRef"
    },
    "context_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Context Fingerprint",
      "type": "string"
    },
    "text": {
      "maxLength": 3500,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "metric_keys": {
      "items": {
        "type": "string"
      },
      "title": "Metric Keys",
      "type": "array"
    },
    "evidence_policy": {
      "default": "legacy-unverified",
      "enum": [
        "legacy-unverified",
        "structured-findings-v1"
      ],
      "title": "Evidence Policy",
      "type": "string"
    },
    "grounded_text": {
      "anyOf": [
        {
          "maxLength": 12000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Grounded Text"
    },
    "source": {
      "const": "ai",
      "default": "ai",
      "title": "Source",
      "type": "string"
    },
    "review_status": {
      "default": "draft",
      "enum": [
        "draft",
        "reviewed"
      ],
      "title": "Review Status",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "reviewed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewed At"
    }
  },
  "required": [
    "id",
    "project_id",
    "revision",
    "result_ref",
    "context_fingerprint",
    "text",
    "metric_keys",
    "created_at"
  ],
  "title": "ResultExplanationV2",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tesisstat.local/contracts/v2/ResultExplanationV2.schema.json"
}
