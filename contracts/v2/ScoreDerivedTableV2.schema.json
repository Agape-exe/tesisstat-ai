    },
    "score_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Score Id",
      "type": "string"
    },
    "source_table_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Source Table Id",
      "type": "string"
    },
    "source_refs": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "title": "Source Refs",
      "type": "array"
    },
    "column_lineage": {
      "items": {
        "$ref": "#/$defs/ColumnLineageV2"
      },
      "title": "Column Lineage",
      "type": "array"
    },
    "row_lineage": {
      "items": {
        "additionalProperties": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": "object"
      },
      "title": "Row Lineage",
      "type": "array"
    }
