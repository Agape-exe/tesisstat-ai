{
  "$defs": {
    "ColumnLineageV2": {
      "additionalProperties": false,
      "properties": {
        "source_table_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Table Id",
          "type": "string"
        },
        "source_column_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Column Id",
          "type": "string"
        },
        "result_column_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Result Column Id"
        }
      },
      "required": [
        "source_table_id",
        "source_column_id",
        "result_column_id"
      ],
      "title": "ColumnLineageV2",
      "type": "object"
    },
    "DatasetRefV2": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2.0.0",
          "default": "2.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "project_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Project Id",
          "type": "string"
        },
        "revision": {
          "const": 1,
          "default": 1,
          "title": "Revision",
          "type": "integer"
        },
        "hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Hash",
          "type": "string"
        },
        "hash_algorithm": {
          "const": "table-json-v1",
          "default": "table-json-v1",
          "title": "Hash Algorithm",
          "type": "string"
        },
        "format": {
          "const": "table_json",
          "default": "table_json",
          "title": "Format",
          "type": "string"
        },
        "kind": {
          "enum": [
            "imported",
            "derived"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/TableColumnV2"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "synthetic": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Synthetic"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "preparation_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "project_id",
        "hash",
        "kind",
        "name",
        "row_count",
        "columns",
        "source_refs"
      ],
      "title": "DatasetRefV2",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "project",
            "context",
            "dataset",
            "dictionary",
            "intent",
            "profile",
            "diagnostic",
            "document",
            "instrument",
            "mapping",
            "recoding",
            "score",
            "plan",
            "result",
            "source_file",
            "source_sheet",
            "table",
            "table_context",
            "preparation",
            "snapshot"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Hash",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "revision",
        "hash"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "TableColumnV2": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "position": {
          "minimum": 0,
          "title": "Position",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "position"
      ],
      "title": "TableColumnV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
