{
  "$defs": {
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "project",
            "context",
            "dataset",
            "dictionary",
            "intent",
            "profile",
            "diagnostic",
            "document",
            "instrument",
            "mapping",
            "recoding",
            "score",
            "plan",
            "result",
            "source_file",
            "source_sheet",
            "table",
            "table_context",
            "preparation",
            "snapshot"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Hash",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "revision",
        "hash"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "TutorActionV2": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "open",
            "propose_update",
            "request_diagnostic",
            "request_proposal",
            "prepare_descriptive",
            "start_association",
            "start_comparison"
          ],
          "title": "Kind",
          "type": "string"
        },
        "resource_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Id"
        },
        "label": {
          "maxLength": 300,
          "title": "Label",
          "type": "string"
        },
        "destination": {
          "enum": [
            "home",
            "context",
            "datasets",
            "analysis",
            "results",
            "instrument"
          ],
          "title": "Destination",
          "type": "string"
        },
        "scope": {
          "default": "",
          "maxLength": 600,
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "label",
        "destination"
      ],
      "title": "TutorActionV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0.0",
      "default": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "project_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "stage": {
      "enum": [
        "home",
        "context",
        "data",
        "analysis",
        "results"
      ],
      "title": "Stage",
      "type": "string"
    },
    "context_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Context Fingerprint",
      "type": "string"
    },
    "source_refs": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "title": "Source Refs",
      "type": "array"
    },
    "confirmed_summary": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Confirmed Summary",
      "type": "object"
    },
    "pending_questions": {
      "items": {
        "type": "string"
      },
      "title": "Pending Questions",
      "type": "array"
    },
    "data_summary": {
      "items": {
        "additionalProperties": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": "object"
      },
      "title": "Data Summary",
      "type": "array"
    },
    "intent_summary": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Intent Summary",
      "type": "object"
    },
    "current_plan_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "current_result_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "historical_refs": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "title": "Historical Refs",
      "type": "array"
    },
    "allowed_actions": {
      "items": {
        "$ref": "#/$defs/TutorActionV2"
      },
      "title": "Allowed Actions",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "stage",
    "context_fingerprint",
    "source_refs",
    "confirmed_summary",
    "pending_questions",
    "data_summary",
    "intent_summary",
    "historical_refs",
    "allowed_actions",
    "warnings"
  ],
  "title": "TutorContextV2",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tesisstat.local/contracts/v2/TutorContextV2.schema.json"
}
