{
  "$defs": {
    "Confirmation": {
      "additionalProperties": false,
      "properties": {
        "actor_ref": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Actor Ref",
          "type": "string"
        },
        "confirmed_at": {
          "format": "date-time",
          "title": "Confirmed At",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "actor_ref",
        "confirmed_at",
        "revision"
      ],
      "title": "Confirmation",
      "type": "object"
    },
    "DatasetRefV2": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2.0.0",
          "default": "2.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "project_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Project Id",
          "type": "string"
        },
        "revision": {
          "const": 1,
          "default": 1,
          "title": "Revision",
          "type": "integer"
        },
        "hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Hash",
          "type": "string"
        },
        "hash_algorithm": {
          "const": "table-json-v1",
          "default": "table-json-v1",
          "title": "Hash Algorithm",
          "type": "string"
        },
        "format": {
          "const": "table_json",
          "default": "table_json",
          "title": "Format",
          "type": "string"
        },
        "kind": {
          "enum": [
            "imported",
            "derived"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/TableColumnV2"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "synthetic": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Synthetic"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "preparation_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "project_id",
        "hash",
        "kind",
        "name",
        "row_count",
        "columns",
        "source_refs"
      ],
      "title": "DatasetRefV2",
      "type": "object"
    },
    "ItemColumnV2": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "format": "uuid",
          "title": "Item Id",
          "type": "string"
        },
        "column_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Column Id",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "column_id"
      ],
      "title": "ItemColumnV2",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "project",
            "context",
            "dataset",
            "dictionary",
            "intent",
            "profile",
            "diagnostic",
            "document",
            "instrument",
            "mapping",
            "recoding",
            "score",
            "plan",
            "result",
            "source_file",
            "source_sheet",
            "table",
            "table_context",
            "preparation",
            "snapshot"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Hash",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "revision",
        "hash"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "TableColumnV2": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "position": {
          "minimum": 0,
          "title": "Position",
          "type": "integer"
        },
        "source_column": {
          "anyOf": [
            {
              "pattern": "^[A-Z]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Column"
        },
        "formula_count": {
          "default": 0,
          "minimum": 0,
          "title": "Formula Count",
          "type": "integer"
        },
        "formula_error_count": {
          "default": 0,
          "minimum": 0,
          "title": "Formula Error Count",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "position"
      ],
      "title": "TableColumnV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0.0",
      "default": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "instrument_ref": {
      "$ref": "#/$defs/SourceRef"
    },
    "dataset_ref": {
      "$ref": "#/$defs/DatasetRefV2"
    },
    "dictionary_ref": {
      "$ref": "#/$defs/SourceRef"
    },
    "item_columns": {
      "items": {
        "$ref": "#/$defs/ItemColumnV2"
      },
      "title": "Item Columns",
      "type": "array"
    },
    "status": {
      "enum": [
        "draft",
        "confirmed",
        "stale"
      ],
      "title": "Status",
      "type": "string"
    },
    "confirmation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Confirmation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "project_id",
    "revision",
    "instrument_ref",
    "dataset_ref",
    "dictionary_ref",
    "item_columns",
    "status"
  ],
  "title": "InstrumentMappingV2",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tesisstat.local/contracts/v2/InstrumentMappingV2.schema.json"
}
